{
  "name": "arrival-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/unit/run.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "balance": "node tests/unit/run.mjs --full",
    "balance:report": "node tests/unit/balance/report.mjs",
    "screenshots": "npx -p playwright@1.50.0 node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "playwright": "1.50.0",
    "tsx": "4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
